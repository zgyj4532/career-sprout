# Copy to career-sprout.env and chmod 600. Never commit the private copy.
CAREER_SPROUT_RELEASE_TAG=
FRONTEND_URL=https://crayzamb.cloud/career-sprout
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CAMPUS_TEACHER_UIDS=

# Create the following Compose secret files beside this template, chmod 600:
# mongo_root_password: unique high-entropy MongoDB administrator password
# mongo_app_password: unique high-entropy readWrite-only application password
# redis_password: unique high-entropy Redis application ACL password
# redis_backup_password: separate high-entropy Redis backup password (PING, SAVE, CLIENT SETINFO only)
# Redis ACL: `user default on >PASSWORD ~api-cache:v1:* ~ai_rl:* +ping +info +get +set +unlink +del +scan +incr +ttl +expire +decr +quit +client|setinfo`
#            `user backup on >BACKUP_PASSWORD +ping +save +client|setinfo`
# Do not put database credentials in this env file or Compose environment values.
